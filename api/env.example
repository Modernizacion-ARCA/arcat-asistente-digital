# Copy this file to .env only when running Django outside Docker Compose.
DJANGO_SETTINGS_MODULE=project.settings.development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

DATABASE_URL=postgresql://arcat:arcat@localhost:5432/arcat

ACTIVAR_HERRAMIENTAS_DEBUGGING=false
PROJECT_NAME_TITLE=Asistente digital ARCAT
PROJECT_NAME_HEADER=Administración ARCAT

# OpenRouter / LLM (complete la key únicamente en su archivo .env local)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
ALLOW_PAID_MODELS=false
MAX_DAILY_LLM_REQUESTS=50
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=1500

# Embeddings locales
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# RAG (tamaños expresados en palabras durante el MVP)
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=8
